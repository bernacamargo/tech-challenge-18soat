{
  "uid": "oficina-api",
  "title": "Oficina — Saúde da API",
  "tags": [
    "oficina",
    "observabilidade"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Coleta da aplicação",
      "description": "1 = coleta bem-sucedida; 0 = falha. Não é uma verificação funcional de todos os serviços.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"oficina\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Tempo desde a inicialização",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_uptime_seconds{job=\"oficina\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Requisições por segundo e rota",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"oficina\",uri!~\"/actuator.*|/api/health\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Respostas por status HTTP / segundo",
      "description": "4xx incluem rejeições esperadas; 5xx indicam falhas internas. Health e coleta excluídos.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"oficina\",uri!~\"/actuator.*|/api/health\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Latência p95 por rota",
      "description": "95% das respostas terminam até este tempo estimado. Sem tráfego pode aparecer sem dados. Não mede a execução de serviços da oficina.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"oficina\",uri!~\"/actuator.*|/api/health\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Latência média por rota",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"oficina\",uri!~\"/actuator.*|/api/health\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"oficina\",uri!~\"/actuator.*|/api/health\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Memória heap da JVM",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"oficina\",area=\"heap\"})",
          "legendFormat": "Usada",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{job=\"oficina\",area=\"heap\"})",
          "legendFormat": "Alocada",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "CPU do processo Java",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"oficina\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Conexões do pool PostgreSQL",
      "description": "Conexões do pool da aplicação; não representa todas as conexões do servidor PostgreSQL.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"oficina\"}",
          "legendFormat": "Ocupadas {{pool}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{job=\"oficina\"}",
          "legendFormat": "Livres {{pool}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max{job=\"oficina\"}",
          "legendFormat": "Limite {{pool}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Threads esperando conexão",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{job=\"oficina\"}",
          "legendFormat": "{{pool}}",
          "range": true
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
